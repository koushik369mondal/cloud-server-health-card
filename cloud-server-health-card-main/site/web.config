<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reads this file at request time. A syntax error here produces
  HTTP 500.19 for the whole site.
-->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- Remove first, then add: a duplicate extension throws 500.19 -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <!-- Lab setting: never cache, so a stale page is always the collector's
           fault and never the browser's. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Detailed errors while you learn. Revert for anything real. -->
    <httpErrors errorMode="Detailed" />
    <directoryBrowse enabled="false" />

  </system.webServer>
</configuration>
